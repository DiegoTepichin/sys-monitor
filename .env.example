# Copy to .env and adjust. config.py loads this file without python-dotenv.

# Required in any shared environment: generate with `openssl rand -hex 32`
API_KEY=change-me

HOST=0.0.0.0
PORT=5002
DEBUG=False

POLL_INTERVAL=5
HISTORY_LIMIT=20

CPU_THRESHOLD=80
MEMORY_THRESHOLD=85
DISK_THRESHOLD=90

LOG_FILE=logs/app.log
FRONTEND_DEV_URL=http://localhost:3000
